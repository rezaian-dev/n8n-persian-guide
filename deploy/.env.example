# Copy to .env, chmod 600, and replace ALL placeholders.
# Generate each secret independently: openssl rand -hex 32
N8N_VERSION=2.45.7
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_PERSISTENT_ENCRYPTION_KEY
N8N_RUNNERS_AUTH_TOKEN=REPLACE_WITH_RANDOM_RUNNER_TOKEN
N8N_HOST=n8n.example.com
N8N_EDITOR_BASE_URL=https://n8n.example.com/
N8N_WEBHOOK_URL=https://n8n.example.com/
# For a single trusted reverse proxy. Adjust to the actual network topology.
N8N_PROXY_HOPS=1
